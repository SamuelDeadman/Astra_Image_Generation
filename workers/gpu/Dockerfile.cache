FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /cache-preparer
RUN pip install --no-cache-dir google-cloud-storage==3.4.1 google-crc32c==1.7.1
COPY workers/gpu/cache_seed.py workers/gpu/model-lock.json ./
RUN useradd --system --uid 10001 cache-preparer
USER 10001
ENTRYPOINT ["python", "/cache-preparer/cache_seed.py"]
